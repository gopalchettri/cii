# Key-free copy of .env for GitHub (2026-11-16): every key, password and connection string is blank.
# To use it: copy it to .env on the machine and fill the blank values; never commit the filled file.
# TSG settings. Secret: never commit (git-ignored). Read by app/core/config.py.

# ---- General ----
# Environment: dev, uat or prod. Missing = prod,
CII_ENV=dev
# How much to log: DEBUG, INFO, WARNING or ERROR.
CII_LOG_LEVEL=DEBUG
# Laptop: folder for log files that Grafana reads (logs). Empty in UAT/prod: pods log to the console.
CII_LOG_DIR=logs
# Web pages allowed to call the API from a browser, comma-separated. * = any (dev only).
CII_CORS_ORIGINS=*

# ---- Databases ----
# SQL Server connection: asset data and the threat/control library (stored procedures only).
# CII_DB_DSN=mssql+pyodbc://@localhost\SQLEXPRESS/EYShield_DESC?driver=ODBC+Driver+17+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=no
CII_DB_DSN=

# MongoDB server address.
CII_MONGO_URL=mongodb://localhost:27017
# MongoDB database that holds all TSG data (runs, scenarios, plans, API keys).
CII_MONGO_DB=cii_tsg
# Redis for live updates and caches (database 0).
CII_REDIS_URL=redis://:@127.0.0.1:6379/0
# Redis for the background job queues (database 1).
CII_REDIS_CELERY_BROKER_URL=redis://:@127.0.0.1:6379/1
# CA file that signed a rediss:// (TLS) Redis server's certificate; empty = the system's CAs.
CII_REDIS_CA_FILE=

# ---- AI: each module's own chat model ----
# Threat scenarios, remediation plans and the service mapper each have their own model, key and limits.
# They can use the same model or different ones; each module's lines are read on their own.
# -- threat scenarios (threat finding and scenario writing) --
# Address of the AI service. Required.
CII_SCENARIO_CHAT_BASE_URL=https://ccpm-control-extraction-resource.services.ai.azure.com/openai/v1
# Key for the AI service. Secret. Required.
CII_SCENARIO_CHAT_API_KEY=
# Model name. Required. It must be listed in app/ai/profiles.py.
CII_SCENARIO_CHAT_MODEL=openai/Kimi-K2.6
# false = the model answers without "thinking" first (faster); true = it thinks first.
CII_SCENARIO_CHAT_MODEL_THINKING=false
# Longest question in tokens. Blank = the model's own limit (kimi-k2.5: 114688, glm-5.3: 262144).
CII_SCENARIO_CHAT_MAX_INPUT_TOKENS=
# Longest answer in tokens. Blank = the model's own limit (12288).
CII_SCENARIO_CHAT_MAX_OUTPUT_TOKENS=12288
# Seconds to wait for one answer before giving up. Blank = the model's own (kimi-k2.5: 120, glm-5.3: 180).
CII_SCENARIO_CHAT_TIMEOUT_SECONDS=120
# Most questions a minute to this model, all pods together. 0 = no limit.
CII_SCENARIO_CHAT_REQUESTS_PER_MINUTE=180
# Most tokens a minute (question + answer room), all pods together. 0 = no limit.
CII_SCENARIO_CHAT_TOKENS_PER_MINUTE=95000
# Most questions at the same time, all pods together. 0 = no fixed limit.
CII_SCENARIO_MAX_CONCURRENT_AI_CALLS=40
# -- remediation plans --
# Address of the AI service. Required.
CII_REMEDIATION_CHAT_BASE_URL=https://ccpm-control-extraction-resource.services.ai.azure.com/openai/v1
# Key for the AI service. Secret. Required.
CII_REMEDIATION_CHAT_API_KEY=
# Model name. Required. It must be listed in app/ai/profiles.py.
CII_REMEDIATION_CHAT_MODEL=openai/Kimi-K2.6
# false = the model answers without "thinking" first (faster); true = it thinks first.
CII_REMEDIATION_CHAT_MODEL_THINKING=false
# Longest question in tokens. Blank = the model's own limit (kimi-k2.5: 114688, glm-5.3: 262144).
CII_REMEDIATION_CHAT_MAX_INPUT_TOKENS=
# Longest answer in tokens. Blank = the model's own limit (12288).
CII_REMEDIATION_CHAT_MAX_OUTPUT_TOKENS=
# Seconds to wait for one answer before giving up. Blank = the model's own (kimi-k2.5: 120, glm-5.3: 180).
CII_REMEDIATION_CHAT_TIMEOUT_SECONDS=
# Most questions a minute to this model, all pods together. 0 = no limit.
CII_REMEDIATION_CHAT_REQUESTS_PER_MINUTE=0
# Most tokens a minute (question + answer room), all pods together. 0 = no limit.
CII_REMEDIATION_CHAT_TOKENS_PER_MINUTE=0
# Most questions at the same time, all pods together. 0 = no fixed limit.
CII_REMEDIATION_MAX_CONCURRENT_AI_CALLS=10
# -- the service mapper --
# Address of the AI service. Required.
CII_SERVICE_MAPPER_CHAT_BASE_URL=https://ccpm-control-extraction-resource.services.ai.azure.com/openai/v1
# Key for the AI service. Secret. Required.
CII_SERVICE_MAPPER_CHAT_API_KEY=
# Model name. Required. It must be listed in app/ai/profiles.py.
CII_SERVICE_MAPPER_CHAT_MODEL=openai/Kimi-K2.6
# false = the model answers without "thinking" first (faster); true = it thinks first.
CII_SERVICE_MAPPER_CHAT_MODEL_THINKING=false
# Longest question in tokens. Blank = the model's own limit (kimi-k2.5: 114688, glm-5.3: 262144).
CII_SERVICE_MAPPER_CHAT_MAX_INPUT_TOKENS=
# Longest answer in tokens. Blank = the model's own limit (12288).
CII_SERVICE_MAPPER_CHAT_MAX_OUTPUT_TOKENS=
# Seconds to wait for one answer before giving up. Blank = the model's own (kimi-k2.5: 120, glm-5.3: 180).
CII_SERVICE_MAPPER_CHAT_TIMEOUT_SECONDS=
# Most questions a minute to this model, all pods together. 0 = no limit.
CII_SERVICE_MAPPER_CHAT_REQUESTS_PER_MINUTE=0
# Most tokens a minute (question + answer room), all pods together. 0 = no limit.
CII_SERVICE_MAPPER_CHAT_TOKENS_PER_MINUTE=0
# Most questions at the same time, all pods together. 0 = no fixed limit.
CII_SERVICE_MAPPER_MAX_CONCURRENT_AI_CALLS=10

# ---- AI: answer room per task, in tokens ----
# The AI service counts this room against its budget while a question runs, so keep it near the real need.
# If an answer needs more, TSG asks once more with the model's full room.
# Threat finding: is each threat relevant to the asset? (about 180 tokens a threat)
CII_ANSWER_TOKENS_RELEVANCE_GATE=8192
# Threat finding: a threat for a STRIDE kind that found none.
CII_ANSWER_TOKENS_GAP_FILL=1024
# Scenario writing: one scenario.
CII_ANSWER_TOKENS_WRITE_SCENARIO=6144
# Scenario writing: a scenario written again after a check.
CII_ANSWER_TOKENS_REPAIR_SCENARIO=5632
# Remediation: one treatment plan (at most about 260 tokens a control).
CII_ANSWER_TOKENS_REMEDIATION_PLAN=3584
# Service mapper: one mapping.
CII_ANSWER_TOKENS_SERVICE_MAPPER=3072
# Control links: which library controls do what one MITRE ATT&CK mitigation says.
CII_ANSWER_TOKENS_LINK_CONTROLS=2048
# Create session: the controls picked for one set of scenarios.
CII_ANSWER_TOKENS_PICK_CONTROLS=3072
# MITRE run answer rooms (required, no value in code).
CII_ANSWER_TOKENS_MITRE_ACTOR_SELECTION=6000
CII_ANSWER_TOKENS_MITRE_PLAN=8192
CII_ANSWER_TOKENS_MITRE_WRITE=4000

# ---- AI: how much TSG asks at once ----
# Threat finding: questions sent at the same time, per run (1 at a 25k-a-minute budget; 3 at 300k).
CII_THREAT_QUESTIONS_AT_ONCE=16
# Threat finding: most whole threats checked in one question (more are split evenly; 12 at 300k).
CII_THREATS_PER_QUESTION=20
# Scenario writing: most scenarios in one write call (3 if a write of 6 times out).
CII_SCENARIOS_WRITTEN_AT_ONCE=6
# Search: reranker calls at the same time, per worker.
CII_RERANKS_AT_ONCE=24
# run.ps1 (laptop, UAT server): threads of the job worker for threats, writing, controls and remediation;
# a thread mostly waits for the AI: 30 for 10 users at once (about 2 x users, plus spare).
CII_WORKER_THREADS=30
# Most tokens one AI call may hold (its question's estimate plus its answer room); a bigger batch goes as halves.
CII_AI_CALL_TOKENS_LIMIT=20000

# ---- AI: when the AI service says "too busy" (HTTP 429) ----
# window, but the answer room its calls reserved and did not use comes back within seconds.
CII_AI_BUSY_MAX_WAIT_SECONDS=20
# Most seconds waited in all, then the job tries again later. The same model is asked again 4 times at most.
CII_AI_BUSY_TOTAL_WAIT_SECONDS=60
# After "too busy", the fewest questions still allowed at the same time.
CII_AI_BUSY_LIMIT_FLOOR=4
# Seconds that slow-down lasts after the last "too busy". Whole number.
CII_AI_BUSY_LIMIT_SECONDS=180

# ---- AI: embeddings (turn text into numbers for search) ----
# Embedding AI endpoint.
CII_EMBEDDING_BASE_URL=https://ccpm-eac-resource.services.ai.azure.com/openai/v1
# Embedding AI key. Secret.
CII_EMBEDDING_API_KEY=
# Embedding model; it needs a profile in app/ai/profiles.
CII_EMBEDDING_MODEL=openai/text-embedding-3-large

# ---- AI: rerank (scores how well each control fits a scenario) ----
# Rerank AI endpoint. Empty = run the local model named below.
CII_RERANK_BASE_URL=
# Rerank AI key. Secret. Empty for a local model.
CII_RERANK_API_KEY=
# Rerank model, or the folder of a local model.
# CII_RERANK_MODEL=C:/Users/User/Documents/GC_Research/Threat_Sceario_Generator/cii-threat-scenario-generator/models/bge-reranker-v2-m3
CII_RERANK_MODEL=C:/Chettri_World/DEVELOPMENT/Models/Reranker/bge-reranker-v2-m3

# ---- AI: all models ----
# Extra header that also carries the AI key (UAT gateway: x-litellm-api-key). Empty = none.
CII_AI_KEY_HEADER=
# ---- Should the AI calls skip the company proxy? true / false / blank (blank = true) ----
# UAT (Windows server): true   -> the AI gateway is called directly
# OpenShift pod:        true   -> the AI gateway is called directly 
# false only where the AI gateway can be reached through the proxy alone
CII_AI_BYPASS_PROXY=true
# ---- The company proxy for the outside calls (the intel feeds): an http(s):// address or blank ----
# UAT (Windows server): blank  -> uses Windows' own proxy setting; if the feeds still fail with ConnectTimeout, put http://<proxy>:<port>
# OpenShift pod:        blank  -> uses the pod's HTTPS_PROXY from deploy/deploy_*.yaml (http://10.61.192.2:8080)
# an address (e.g. http://10.61.192.2:8080) = every outside call uses it; with CII_AI_BYPASS_PROXY=false the AI calls too
CII_PROXY_URL=
# Search (embedding and reranker): most calls at the same time, all pods together. 0 = no fixed limit.
CII_MAX_CONCURRENT_AI_CALLS=0

# true = every workflow step logs its redacted inputs, results, output, time and errors
# (app/core/tracing.py); false = only the operational, security and audit logs. Needs CII_LOG_LEVEL=INFO or DEBUG.
# Inner sub-step records inside each traced step (BM25, similarity, merges, ranking...); only when
# DEBUG_STEP_OUTPUT is true. DEBUG_STEP_TOP = entries a ranked record keeps (1-40).

# How many scenarios a run writes: 0 = every valid path found, one per relevant threat per STRIDE category
# (a threat on several systems is still one; no per-system limit); N = the N most relevant.
# Applied after every path is found and ranked; never padded. A whole number of 0 or more.
TOTAL_SCENARIO_COUNT=15

# Scenario sets: the first set, then each next set; the total is TOTAL_SCENARIO_COUNT.
INITIAL_SET_SIZE=6
NEXT_SET_SIZE=6
REGENERATIONS_MAX_VERSION_COUNT=10
SERVICE_MAPPER_UPSTREAM_TOTAL_COUNT=10
SERVICE_MAPPER_DOWNSTREAM_TOTAL_COUNT=10
SERVICE_MAPPER_MAX_GENERATIONS=5

# ---- Asset and supporting-system facts ----
# Which facts a run USES: every column dbo.tsg_GetAssetContext returns (scripts/sql/tsg_GetAssetContext.sql).
#   To HIDE a fact, put -- at the start of its line in PART 1 (asset) or PART 4 (systems) of that script; remove
#   the -- to SHOW it again; add a line there for a new fact (a new dropdown must return the option's name).
#   Install the script again: the next run uses it, no restart, no code change.
# Which facts a run REQUIRES (a start without one is refused: 422 required_facts_missing, nothing saved):
#   comma-separated column names of that procedure, spaces allowed; empty = none. Restart after a change.
#   A name the procedure does not return refuses every run (500 setup_error naming it); id, name,
#   category_code and alias are always used and cannot be listed (start-up stops).
# "Recorded" = what the AI would be shown: 0 and No count; empty, N/A, none or an unanswered list do not.
# Example: SYSTEM_PROPERTIES_REQUIRED=technology_used  -> a start is refused if a chosen system has none recorded
# Trade-off: requiring raises quality, but runs on incomplete records are refused until the data is filled in.
ASSET_PROPERTIES_REQUIRED=
SYSTEM_PROPERTIES_REQUIRED=

# ---- Similarity thresholds ----
# All three use the reranker's relevance score, 0-100: how well two texts match. Higher = stricter.
# A change takes effect after a restart (.\run.ps1 stop, then start), for new work only: controls
# already mapped keep theirs. Calibrate per environment: the laptop and UAT rerankers score differently.
#
# CONTROL_SIMILARITY_THRESHOLD: a library control scoring at or above it is mapped to a scenario.
#   Increase: fewer, sharper controls; more scenarios get only the single "nearest" one, with a warning.
#   Decrease: more controls, including weaker matches. Either way a scenario always keeps one control.
#   Example: controls scoring 87, 72, 64, 41 -> at 40: all 4; at 60: 3; at 80: 1;
#   at 90: none reaches it, so 87 is kept as "nearest", with a warning.
CONTROL_SIMILARITY_THRESHOLD=50
CONTROL_CANDIDATES=40 # for UAT make it 30
MIN_CONTROLS=3
MAX_CONTROLS=10
NEAREST_CONTROLS=3
THREAT_SCENARIO_WORD_LIMIT=120-180
RISK_STATEMENT_WORD_LIMIT=80-120
EVIDENCE_STATEMENT_WORD_LIMIT=20-60
# THREAT_SIMILARITY_THRESHOLD: an AI-proposed threat scoring at or above it against a library threat IS
#   that threat (dropped as a repeat); its type must reach it too to take a library type.
#   Increase: fewer called repeats, so more AI threats kept as new; more become curator notes (no type).
#   Decrease: more AI threats dropped as repeats of library threats; more take a library type.
#   Example: a proposal scoring 80 against "Admin privilege abuse", its type scoring 90 -> at 75: a
#   repeat, dropped; at 85: a new threat with the library type; at 95: a curator note, not a scenario.
THREAT_SIMILARITY_THRESHOLD=60
# EXTERNAL_INTELLIGENCE_ENABLED: the MASTER switch for external intelligence (MITRE ATT&CK Enterprise
#   and ICS). false = nothing is imported or searched and new scenarios carry no evidence, whatever
#   an admin sets at run time; scenarios written while it was on keep their evidence, and revoking a
#   source still deletes its data.
#   Increase/Decrease: true or false; true = on (an admin may still turn it off at run time).
#   Default when the line is missing: false, so dev says true explicitly.
EXTERNAL_INTELLIGENCE_ENABLED=true
# EVIDENCE_KEPT_PER_THREAT: how many scored records are kept per threat (1-10): 1 = the best, 2 = the best
#   two, etc., at or above the threshold, else the nearest. A scenario cites at most one.
EVIDENCE_KEPT_PER_THREAT=3
# EVIDENCE_CANDIDATES: how many records the search hands the reranker to score per threat (1-100).
EVIDENCE_CANDIDATES=30
# EVIDENCE_SIMILARITY_THRESHOLD: an intelligence record scoring at or above it (reranker, 0-100) counts as
#   direct evidence for a threat. A ranking score, not a probability; provisional: calibrate per environment
#   and per reranker model by reading a threat's search audit (every candidate, with its score).
#   When no record reaches it, the threat's nearest records (up to EVIDENCE_KEPT_PER_THREAT) are used and
#   cited as "related": the threshold never leaves a threat without evidence.
#   Increase: fewer records count as direct evidence; more threats fall back to "related" records.
#   Decrease: more records count as direct evidence, weaker fits included.
#   Example: records scoring 12, 3, 0.4 -> at 1: the first two; at 5: the first; at 20: none passes, so
#   the nearest are used, cited as related.
# Calibrated on the local bge-reranker-v2-m3 (30). Other rerankers score differently.
EVIDENCE_SIMILARITY_THRESHOLD=50
# THREAT_CONTEXT_COUNTRY: the country the assets are in, "UAE" or "United Arab Emirates". With external
# intelligence on, planning and the writer read it as a fact; it ranks nothing.
THREAT_CONTEXT_COUNTRY=United Arab Emirates
# MITRE run (POST /v1/mitre_create_session, ADR-010): every line required, no value in code.
ACTOR_PROFILE_DESCRIPTION_CHARACTERS=1200
MITRE_MINIMUM_QUOTE_WORDS=5
PLANNER_RELEVANT_ACTORS=15
ATTACK_PATH_TECHNIQUES=3-6
MITRE_PLANNER_SINGLE_CALL_LIMIT=40
MITRE_DUPLICATE_TECHNIQUE_OVERLAP=0.7
CATALOGUE_SUMMARY_SENTENCES=1
CATALOGUE_SUMMARY_CHARACTERS=70
ICS_ASSET_DESCRIPTION_CHARACTERS=150
CANDIDATE_GROUPS_PER_SCENARIO=15
MITRE_MINIMUM_CANDIDATES_AFTER_TRIM=3
MITRE_GROUPS_PER_SCENARIO=3
MAX_SCENARIO_SHARE_PER_GROUP=0.5
PROCEDURES_PER_TECHNIQUE=10
PROCEDURE_TEXT_CHARACTERS=300
SOFTWARE_DESCRIPTION_CHARACTERS=300
WRITER_CANDIDATE_DESCRIPTION_CHARACTERS=600
MITRE_THREAT_SCENARIO_WORD_LIMIT=100-150
MITRE_RISK_STATEMENT_WORD_LIMIT=30-40
MITRE_RISK_TITLE_WORD_LIMIT=4-10
MITRE_SCENARIO_TITLE_WORD_LIMIT=3-8
MITRE_WORDS_PER_SENTENCE=15
MITRE_RELEVANCE_RANGE=2-5
MITRE_EXTRA_PATHS_PER_SCOPE=2
MITRE_EXTRA_PATHS_IN_ONE_CALL=5
MITRE_CROSSING_REASON_CHARACTERS=300
MITRE_MINIMUM_SCENARIO_SENTENCES=3
MITRE_WORD_LIMIT_SLACK=0.1
MITRE_PARALLEL_WRITERS=5
MITRE_PLAN_CALL_TOKENS_LIMIT=60000
MITRE_WRITE_CALL_TOKENS_LIMIT=34000

# ---- Access ----
# Key for admin calls (e.g. creating API keys). Secret. Empty = admin calls off; 32+ characters outside dev.
CII_ADMIN_API_KEY=

# ---- Limits and monitoring ----
# Largest request body in MB; a bigger one is refused (413).
CII_MAX_REQUEST_MB=2
# Port where each worker shows its numbers to Prometheus.
CII_WORKER_METRICS_PORT=9100



# ---- Grafana (the monitoring screens): laptop in .env, UAT in .env.uat ----
# -- Who can see and edit --
# Anyone may look without logging in.
GF_AUTH_ANONYMOUS_ENABLED=true
# What a visitor without a login may do: Viewer, Editor or Admin.
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
# -- Reporting, analytics and calls to the internet --
# Send usage statistics to Grafana Labs.
GF_ANALYTICS_REPORTING_ENABLED=false

# api-key:<removed>


# Embedding and reranker: most requests a minute each, all pods together. 0 = no limit.
CII_EMBEDDING_REQUESTS_PER_MINUTE=0
CII_RERANK_REQUESTS_PER_MINUTE=0
# Threat finding: hours a run takes an earlier run's answer to the very same question; 0 = always ask.
CII_THREAT_FINDING_REUSE_HOURS=24
