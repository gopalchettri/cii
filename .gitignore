.env
.env.*
!.env.example
# Key-free copies of .env and .env.uat (every key, password and connection string blank)
!.env.dev.example
!.env.uat.example
# Local copies of the env files (they hold real keys)
.env copy*
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
logs/
celerybeat-schedule*
deploy/monitoring.env
.run/

# One-time data backups (never committed)
backups/

# The real OpenShift secrets (deploy/secrets.example.yaml is the template in git)
deploy/secrets.yaml

# Personal Claude Code settings
.claude/settings.local.json
