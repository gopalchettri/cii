# Your own values for debug/tsg.http and the VS Code tasks (docs/DEBUGGING.md, step 6).
# Copy this file to debug/.env and fill it in. debug/.env is git-ignored: never commit it (TSG_API_KEY is a secret).

# Your API key. The admin mints it with request 3 in debug/tsg.http. Laptop and UAT keys differ: put the key of the
# TSG you are calling.
TSG_API_KEY=
# Who you are (as a caller sends X-User-Id).
TSG_USER_ID=
# The entity whose runs you look at (X-Entity-Id, a whole number).
TSG_ENTITY_ID=86
# The tenant (X-Tenant-Id).
TSG_TENANT_ID=DESC
# The run you are looking at. The task 'TSG: make a test run (laptop)' fills it in.
TSG_RUN_ID=
