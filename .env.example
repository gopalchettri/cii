# Copy to .env and fill in. Every line is read by app/core/config.py (a test keeps them in sync).

# ---- General ----
# Environment: dev (laptop), uat or prod. Missing = prod, which refuses laptop-only values.
CII_ENV=dev
# How much to log: DEBUG, INFO, WARNING or ERROR.
CII_LOG_LEVEL=INFO
# Laptop: folder for log files that Grafana reads (logs). Empty in UAT/prod: pods log to the console.
CII_LOG_DIR=logs
# Web pages allowed to call the API from a browser, comma-separated. * = any (dev and UAT; prod refuses it).
CII_CORS_ORIGINS=*

# ---- Databases ----
# SQL Server connection: asset data and the threat/control library (stored procedures only).
CII_DB_DSN=mssql+pyodbc://@localhost\SQLEXPRESS/DevTest5?driver=ODBC+Driver+17+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=no
# MongoDB server address.
CII_MONGO_URL=mongodb://localhost:27017
# MongoDB database that holds all TSG data (runs, scenarios, plans, API keys).
CII_MONGO_DB=cii_tsg
# Redis for live updates and caches (database 0).
CII_REDIS_URL=redis://:@127.0.0.1:6379/0
# Redis for the background job queues (database 1).
CII_REDIS_CELERY_BROKER_URL=redis://:@127.0.0.1:6379/1
# CA file that signed a rediss:// (TLS) Redis server's certificate, when the system's trusted CAs did not.
# Empty = the system's. rediss:// always checks the certificate and host name; redis:// is plain.
CII_REDIS_CA_FILE=

# ---- AI: each module's own chat model ----
# Threat scenarios, remediation plans and the service mapper each have their own model, key and limits.
# They can use the same model or different ones; each module's lines are read on their own.
# -- threat scenarios (threat finding and scenario writing) --
# Address of the AI service. Required.
CII_SCENARIO_CHAT_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
# Key for the AI service. Secret. Required.
CII_SCENARIO_CHAT_API_KEY=<secret>
# Model name. Required. It must be listed in app/ai/profiles.py.
CII_SCENARIO_CHAT_MODEL=openai/Kimi-K2.6
# false = the model answers without "thinking" first (faster); true = it thinks first.
CII_SCENARIO_CHAT_MODEL_THINKING=false
# Longest question in tokens. Blank = the model's own limit (kimi-k2.5: 114688, glm-5.3: 262144).
CII_SCENARIO_CHAT_MAX_INPUT_TOKENS=
# Longest answer in tokens. Blank = the model's own limit (12288).
CII_SCENARIO_CHAT_MAX_OUTPUT_TOKENS=
# Seconds to wait for one answer before giving up. Blank = the model's own (kimi-k2.5: 120, glm-5.3: 180).
CII_SCENARIO_CHAT_TIMEOUT_SECONDS=
# Most questions a minute to this model, all pods together. 0 = no limit.
CII_SCENARIO_CHAT_REQUESTS_PER_MINUTE=0
# Most tokens a minute (question + answer room), all pods together. 0 = no limit.
CII_SCENARIO_CHAT_TOKENS_PER_MINUTE=0
# Most questions at the same time, all pods together. 0 = no fixed limit.
CII_SCENARIO_MAX_CONCURRENT_AI_CALLS=16
# Backup model, used when the main one is busy or down. Blank = no backup, and the backup lines below are ignored.
CII_SCENARIO_CHAT_FALLBACK_MODEL=
# false = the backup model answers without "thinking" first.
CII_SCENARIO_CHAT_FALLBACK_MODEL_THINKING=false
# Backup: longest question in tokens. Blank = its own limit.
CII_SCENARIO_CHAT_FALLBACK_MAX_INPUT_TOKENS=
# Backup: longest answer in tokens. Blank = its own limit.
CII_SCENARIO_CHAT_FALLBACK_MAX_OUTPUT_TOKENS=
# Backup: seconds to wait for one answer. Blank = its own.
CII_SCENARIO_CHAT_FALLBACK_TIMEOUT_SECONDS=
# Backup: most questions a minute, all pods together. 0 = no limit.
CII_SCENARIO_CHAT_FALLBACK_REQUESTS_PER_MINUTE=0
# Backup: most questions at the same time, all pods together. 0 = no limit.
CII_SCENARIO_MAX_CONCURRENT_FALLBACK_CALLS=0
# -- remediation plans --
# Address of the AI service. Required.
CII_REMEDIATION_CHAT_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
# Key for the AI service. Secret. Required.
CII_REMEDIATION_CHAT_API_KEY=<secret>
# Model name. Required. It must be listed in app/ai/profiles.py.
CII_REMEDIATION_CHAT_MODEL=openai/Kimi-K2.6
# false = the model answers without "thinking" first (faster); true = it thinks first.
CII_REMEDIATION_CHAT_MODEL_THINKING=false
# Longest question in tokens. Blank = the model's own limit (kimi-k2.5: 114688, glm-5.3: 262144).
CII_REMEDIATION_CHAT_MAX_INPUT_TOKENS=
# Longest answer in tokens. Blank = the model's own limit (12288).
CII_REMEDIATION_CHAT_MAX_OUTPUT_TOKENS=
# Seconds to wait for one answer before giving up. Blank = the model's own (kimi-k2.5: 120, glm-5.3: 180).
CII_REMEDIATION_CHAT_TIMEOUT_SECONDS=
# Most questions a minute to this model, all pods together. 0 = no limit.
CII_REMEDIATION_CHAT_REQUESTS_PER_MINUTE=0
# Most tokens a minute (question + answer room), all pods together. 0 = no limit.
CII_REMEDIATION_CHAT_TOKENS_PER_MINUTE=0
# Most questions at the same time, all pods together. 0 = no fixed limit.
CII_REMEDIATION_MAX_CONCURRENT_AI_CALLS=16
# Backup model, used when the main one is busy or down. Blank = no backup, and the backup lines below are ignored.
CII_REMEDIATION_CHAT_FALLBACK_MODEL=
# false = the backup model answers without "thinking" first.
CII_REMEDIATION_CHAT_FALLBACK_MODEL_THINKING=false
# Backup: longest question in tokens. Blank = its own limit.
CII_REMEDIATION_CHAT_FALLBACK_MAX_INPUT_TOKENS=
# Backup: longest answer in tokens. Blank = its own limit.
CII_REMEDIATION_CHAT_FALLBACK_MAX_OUTPUT_TOKENS=
# Backup: seconds to wait for one answer. Blank = its own.
CII_REMEDIATION_CHAT_FALLBACK_TIMEOUT_SECONDS=
# Backup: most questions a minute, all pods together. 0 = no limit.
CII_REMEDIATION_CHAT_FALLBACK_REQUESTS_PER_MINUTE=0
# Backup: most questions at the same time, all pods together. 0 = no limit.
CII_REMEDIATION_MAX_CONCURRENT_FALLBACK_CALLS=0
# -- the service mapper --
# Address of the AI service. Required.
CII_SERVICE_MAPPER_CHAT_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
# Key for the AI service. Secret. Required.
CII_SERVICE_MAPPER_CHAT_API_KEY=<secret>
# Model name. Required. It must be listed in app/ai/profiles.py.
CII_SERVICE_MAPPER_CHAT_MODEL=openai/Kimi-K2.6
# false = the model answers without "thinking" first (faster); true = it thinks first.
CII_SERVICE_MAPPER_CHAT_MODEL_THINKING=false
# Longest question in tokens. Blank = the model's own limit (kimi-k2.5: 114688, glm-5.3: 262144).
CII_SERVICE_MAPPER_CHAT_MAX_INPUT_TOKENS=
# Longest answer in tokens. Blank = the model's own limit (12288).
CII_SERVICE_MAPPER_CHAT_MAX_OUTPUT_TOKENS=
# Seconds to wait for one answer before giving up. Blank = the model's own (kimi-k2.5: 120, glm-5.3: 180).
CII_SERVICE_MAPPER_CHAT_TIMEOUT_SECONDS=
# Most questions a minute to this model, all pods together. 0 = no limit.
CII_SERVICE_MAPPER_CHAT_REQUESTS_PER_MINUTE=0
# Most tokens a minute (question + answer room), all pods together. 0 = no limit.
CII_SERVICE_MAPPER_CHAT_TOKENS_PER_MINUTE=0
# Most questions at the same time, all pods together. 0 = no fixed limit.
CII_SERVICE_MAPPER_MAX_CONCURRENT_AI_CALLS=16
# Backup model, used when the main one is busy or down. Blank = no backup, and the backup lines below are ignored.
CII_SERVICE_MAPPER_CHAT_FALLBACK_MODEL=
# false = the backup model answers without "thinking" first.
CII_SERVICE_MAPPER_CHAT_FALLBACK_MODEL_THINKING=false
# Backup: longest question in tokens. Blank = its own limit.
CII_SERVICE_MAPPER_CHAT_FALLBACK_MAX_INPUT_TOKENS=
# Backup: longest answer in tokens. Blank = its own limit.
CII_SERVICE_MAPPER_CHAT_FALLBACK_MAX_OUTPUT_TOKENS=
# Backup: seconds to wait for one answer. Blank = its own.
CII_SERVICE_MAPPER_CHAT_FALLBACK_TIMEOUT_SECONDS=
# Backup: most questions a minute, all pods together. 0 = no limit.
CII_SERVICE_MAPPER_CHAT_FALLBACK_REQUESTS_PER_MINUTE=0
# Backup: most questions at the same time, all pods together. 0 = no limit.
CII_SERVICE_MAPPER_MAX_CONCURRENT_FALLBACK_CALLS=0

# ---- AI: answer room per task, in tokens ----
# The AI service counts this room against its budget while a question runs, so keep it near the real need.
# If an answer needs more, TSG asks once more with the model's full room.
# Threat finding: is each threat relevant to the asset, and as which kinds? (one answer for up to 40 threats)
CII_ANSWER_TOKENS_RELEVANCE_GATE=10240
# Threat finding: a threat for a STRIDE kind that found none.
CII_ANSWER_TOKENS_GAP_FILL=1024
# Scenario writing: the actions a threat's name states (no longer asked: the threat check gives them).
CII_ANSWER_TOKENS_THREAT_ACTIONS=1024
# Scenario writing: one set of scenarios in one answer (about 550 tokens a scenario).
CII_ANSWER_TOKENS_WRITE_SCENARIO=6144
# Scenario writing: a set's scenarios written again after a check, in one answer.
CII_ANSWER_TOKENS_REPAIR_SCENARIO=6144
# Scenario writing: does each scenario of a set carry out its plan? (one answer for the set)
CII_ANSWER_TOKENS_PLAN_CHECK=3072
# Remediation: one treatment plan (about 140 tokens a control).
CII_ANSWER_TOKENS_REMEDIATION_PLAN=8192
# Service mapper: one mapping.
CII_ANSWER_TOKENS_SERVICE_MAPPER=4096

# ---- AI: how much TSG asks at once ----
# Threat finding: questions sent at the same time, per run (1 at a 25k-a-minute budget; 3 at 300k).
CII_THREAT_QUESTIONS_AT_ONCE=1
# Threat finding: most whole threats checked in one question (more are split evenly; 12 at 300k).
CII_THREATS_PER_QUESTION=40
# Scenario writing: most scenarios in one write call (3 if a write of 6 times out).
CII_SCENARIOS_WRITTEN_AT_ONCE=6
# Search: reranker calls at the same time, per worker.
CII_RERANKS_AT_ONCE=6
# Most tokens one AI call may hold (its question's estimate plus its answer room); a bigger batch goes as halves.
CII_AI_CALL_TOKENS_LIMIT=20000

# ---- AI: when the AI service says "too busy" (HTTP 429) ----
# Longest wait, in seconds, before asking the same model again (+-20%). LiteLLM always asks for its whole 60 s
# window, but the answer room its calls reserved and did not use comes back within seconds.
CII_AI_BUSY_MAX_WAIT_SECONDS=20
# Most seconds waited in all, then the backup model is tried. The same model is asked again 4 times at most.
CII_AI_BUSY_TOTAL_WAIT_SECONDS=60
# Seconds a refused model is tried last (its backup goes first).
CII_AI_MODEL_COOL_DOWN_SECONDS=120
# After "too busy", the fewest questions still allowed at the same time.
CII_AI_BUSY_LIMIT_FLOOR=4
# Seconds that slow-down lasts after the last "too busy". Whole number.
CII_AI_BUSY_LIMIT_SECONDS=180

# ---- AI: embeddings (turn text into numbers for search) ----
# Embedding AI endpoint.
CII_EMBEDDING_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
# Embedding AI key. Secret.
CII_EMBEDDING_API_KEY=<secret>
# Embedding model; it needs a profile in app/ai/profiles.py.
CII_EMBEDDING_MODEL=openai/text-embedding-3-large

# ---- AI: rerank (scores how well each control fits a scenario) ----
# Rerank AI endpoint. Empty = run the local model named below.
CII_RERANK_BASE_URL=
# Rerank AI key. Secret. Empty for a local model.
CII_RERANK_API_KEY=
# Rerank model, or the folder of a local model.
CII_RERANK_MODEL=C:/models/bge-reranker-v2-m3

# ---- AI: all models ----
# Extra header that also carries the AI key (UAT gateway: x-litellm-api-key). Empty = none.
CII_AI_KEY_HEADER=
# ---- Should the AI calls skip the company proxy? true / false / blank (blank = true) ----
# UAT (Windows server): true   -> the AI gateway is called directly
# OpenShift pod:        true   -> the AI gateway is called directly (owner 2026-10-16)
# false only where the AI gateway can be reached through the proxy alone
CII_AI_BYPASS_PROXY=true
# ---- The company proxy for the outside calls (the intel feeds): an http(s):// address or blank ----
# UAT (Windows server): blank  -> uses Windows' own proxy setting; if the feeds still fail with ConnectTimeout, put http://<proxy>:<port>
# OpenShift pod:        blank  -> uses the pod's HTTPS_PROXY from deploy/deploy_*.yaml (http://10.61.192.2:8080)
# an address (e.g. http://10.61.192.2:8080) = every outside call uses it; with CII_AI_BYPASS_PROXY=false the AI calls too
CII_PROXY_URL=
# Search (embedding and reranker): most calls at the same time, all pods together. 0 = no fixed limit.
CII_MAX_CONCURRENT_AI_CALLS=16
# Embedding and reranker: most requests a minute each, all pods together. 0 = no limit.
CII_EMBEDDING_REQUESTS_PER_MINUTE=0
CII_RERANK_REQUESTS_PER_MINUTE=0

# How many scenarios a run writes: 0 = every path found, one per relevant threat per STRIDE
# category (a threat on several systems is still one; no per-system limit); N = the N most relevant.
# Applied after every path is found and ranked; never padded. A whole number of 0 or more.
TOTAL_SCENARIO_COUNT=0

# Scenarios are written set by set, only when asked (owner 2026-10-11): a run writes its first
# INITIAL_SET_SIZE so a reviewer can start reading; each "next set" call writes the next NEXT_SET_SIZE.
# A review batch size, not a limit: the total comes from TOTAL_SCENARIO_COUNT. Whole numbers of 1 or more.
INITIAL_SET_SIZE=6
NEXT_SET_SIZE=6
# REGENERATIONS_MAX_VERSION_COUNT: the most versions one remediation plan keeps (the first plan + regenerates).
#   Every version sits in the plan's one MongoDB record (about 100-400 KB each) and MongoDB refuses a record
#   over 16 MB, so 40 is the hard upper limit. 10 = the first plan + 9 regenerates. Whole number 1-40.
REGENERATIONS_MAX_VERSION_COUNT=10

# Service Mapper: how many upstream services (the selected service needs them) and downstream services (they
#   need the selected service) the AI is asked for. Fewer is fine when no more are defensible; a service is never
#   in both lists. 0 turns a direction off. Whole number 0-100.
SERVICE_MAPPER_UPSTREAM_TOTAL_COUNT=10
SERVICE_MAPPER_DOWNSTREAM_TOTAL_COUNT=10
# SERVICE_MAPPER_MAX_GENERATIONS: runs per mapping, the first included (Generate, then Generate again or
#   Regenerate, each adding only services the mapping does not hold yet). 0 = no limit.
SERVICE_MAPPER_MAX_GENERATIONS=5

# Asset and supporting-system facts (owner 2026-10-11): a run uses every column dbo.tsg_GetAssetContext
# returns (PART 1 and PART 4 of scripts/sql/tsg_GetAssetContext.sql: put -- in front of a line to hide that fact,
# remove it to show it again; no code change). These lines name the facts a run REQUIRES (a start
# without one is refused 422): comma-separated column names of that procedure; empty = none. A name the
# procedure does not return refuses every run (500 setup_error); id, name, category_code, alias cannot be listed.
# Asset columns today: cii_asset_description, critical_service, sector, sub_sector, data_handled, asset_type,
#   operating_system, location, target_rto_hours, target_rpo_hours, asset_priority, entity_technology_context.
# System columns today: category_name, past_incidents, technology_used, vendor_name, database_platforms,
#   targeted_users, saas_platform_list, public_cloud_platforms, min_no_of_transactions, max_no_of_transactions,
#   user_base_count, accessability_channel, hosting_location, dr_location, network_connectivity_primary_dr,
#   dr_drill_frequency, managed_by, maintenance_contract_exists, last_dr_test_date, backup_multi_site,
#   backup_retention_period_days, backup_tested, offsite_air_gapped_backup, data_residency_restrictions,
#   data_residency_restriction_justification, document_drp_exists, saas_backup_required, rto_target_mins,
#   rpo_target_mins, data_loss_incident_last_3_years.
ASSET_PROPERTIES_REQUIRED=
SYSTEM_PROPERTIES_REQUIRED=

# ---- Similarity thresholds (owner 2026-10-11) ----
# All three use the reranker's relevance score, 0-100: how well two texts match. Higher = stricter.
# A change takes effect after a restart (.\run.ps1 stop, then start), for new work only: controls
# already mapped keep theirs. Calibrate per environment: the laptop and UAT rerankers score differently.
#
# CONTROL_SIMILARITY_THRESHOLD: a library control scoring at or above it is mapped to a scenario.
#   Increase: fewer, sharper controls; more scenarios get only the single "nearest" one, with a warning.
#   Decrease: more controls, including weaker matches. Either way a scenario always keeps one control.
#   Example: controls scoring 87, 72, 64, 41 -> at 40: all 4; at 60: 3; at 80: 1;
#   at 90: none reaches it, so 87 is kept as "nearest", with a warning.
CONTROL_SIMILARITY_THRESHOLD=50
# CONTROL_CANDIDATES, MIN_CONTROLS, MAX_CONTROLS (owner 2026-10-13, G225, G227): a scenario's controls in five
#   steps: (1) the CONTROL_CANDIDATES closest library controls fitting the asset type are found; (2) the
#   reranker scores each 0-100; (3) every one at or above CONTROL_SIMILARITY_THRESHOLD is kept ("strong");
#   (4) never more than MAX_CONTROLS; (5) fewer than MIN_CONTROLS strong: the nearest top them up to it;
#   none strong: the NEAREST_CONTROLS nearest are kept ("fallback"). Never zero.
#   Rules: CANDIDATES >= MAX >= MIN >= 1 and MAX >= NEAREST >= 1. Same 0-100 scale: 0.50 is written 50.
#   Fewer candidates = faster mapping on a laptop CPU reranker (each one is scored).
#   CONTROL_CANDIDATES has no value in code (G249): this line is required, else the app does not start.
#   Example (3 / 5 / 3): scores 87, 72, 41, 30 -> threshold 50: 87, 72 strong + 41 to reach 3;
#   threshold 90: none strong, so the 3 nearest 87, 72, 41.
CONTROL_CANDIDATES=40
MIN_CONTROLS=3
MAX_CONTROLS=5
NEAREST_CONTROLS=3
# THREAT_SCENARIO_WORD_LIMIT, RISK_STATEMENT_WORD_LIMIT, EVIDENCE_STATEMENT_WORD_LIMIT (owner 2026-10-19):
#   min-max words the writer is asked for; the upper number is a hard limit, the lower a target. The
#   evidence passage ends a story with intelligence on, on top of the scenario statement's own limit.
THREAT_SCENARIO_WORD_LIMIT=150-200
RISK_STATEMENT_WORD_LIMIT=100-150
EVIDENCE_STATEMENT_WORD_LIMIT=30-80
# THREAT_SIMILARITY_THRESHOLD: an AI-proposed threat scoring at or above it against a library threat IS
#   that threat (dropped as a repeat); its type must reach it too to take a library type.
#   Increase: fewer called repeats, so more AI threats kept as new; more become curator notes (no type).
#   Decrease: more AI threats dropped as repeats of library threats; more take a library type.
#   Example: a proposal scoring 80 against "Admin privilege abuse", its type scoring 90 -> at 75: a
#   repeat, dropped; at 85: a new threat with the library type; at 95: a curator note, not a scenario.
THREAT_SIMILARITY_THRESHOLD=75
# EXTERNAL_INTELLIGENCE_ENABLED: the MASTER switch for external intelligence (CISA KEV, EPSS, MITRE ATT&CK,
#   CISA ICS, NVD). false = nothing is read, searched or shown, whatever an admin sets at run time.
#   Increase/Decrease: true or false; true = on (an admin may still turn it off at run time).
#   Default when the line is missing: false (a deployment that forgets it stays the original TSG), so every
#   environment that wants intelligence says true here explicitly (dev does).
EXTERNAL_INTELLIGENCE_ENABLED=false
# EVIDENCE_SIMILARITY_THRESHOLD: an intelligence record scoring at or above it (reranker, 0-100) counts as
#   evidence for a threat. A ranking score, not a probability; provisional: calibrate per environment and
#   per reranker model by reading a threat's search audit (every candidate, with its score).
#   Increase: fewer, closer records; more threats with no evidence.
#   Decrease: more records, weaker fits included.
#   Example: records scoring 12, 3, 0.4 -> at 1: the first two; at 5: the first; at 20: none.
#   PER ENVIRONMENT: dev (local bge-reranker-v2-m3) uses 30, calibrated 2026-10-19 on 36 labelled threats with
#   the reranker reading clean technique text. UAT/prod rerank with the LiteLLM-hosted
#   qwen3-reranker-8b, which scores on another scale: set the value from
#   scripts/calibrate_evidence_threshold.py. Outside dev, start-up refuses a missing line while
#   EXTERNAL_INTELLIGENCE_ENABLED is true. /v1/tsg/intel/health shows threshold_calibrated.
EVIDENCE_SIMILARITY_THRESHOLD=30
# EVIDENCE_CANDIDATES: how many intelligence records the reranker scores per threat (1-100, default 30).
#   Increase: the right record is found more often; each rerank takes longer (a remote reranker scores
#   them in one call, the local CPU model 6 at a time). Decrease: faster, but a close record can be
#   crowded out by records that only share words with the threat.
EVIDENCE_CANDIDATES=30
# EVIDENCE_KEPT_PER_THREAT: how many records at or above the threshold are kept per threat (1-10, default 3).
#   The writer sees every kept record as background and cites one; the rest are recorded as over_limit.
EVIDENCE_KEPT_PER_THREAT=3
# THREAT_CONTEXT_COUNTRY (G232): the country the assets are in, "UAE" or "United Arab Emirates". With external
# intelligence on, planning and the writer read it as a fact; it ranks nothing.
THREAT_CONTEXT_COUNTRY=United Arab Emirates
# Optional NVD API key. Secret. Empty = unkeyed (NVD allows 5 requests per 30 s instead of 50).
CII_NVD_API_KEY=

# ---- Access ----
# Key for admin calls (e.g. creating API keys). Secret. Empty = admin calls off; 32+ characters outside dev.
CII_ADMIN_API_KEY=<secret>

# ---- Limits and monitoring ----
# Largest request body in MB; a bigger one is refused (413).
CII_MAX_REQUEST_MB=2
# Port where each worker shows its numbers to Prometheus.
CII_WORKER_METRICS_PORT=9100

# ---- Grafana (the monitoring screens): laptop in .env, UAT in .env.uat ----
# Grafana admin password, only to change Grafana (viewing needs no login). Laptop: empty = a random one.
# UAT: optional. No line = no Grafana login at all (a random admin password nobody sees); a line = 16+ characters.
GRAFANA_ADMIN_PASSWORD=
# Any Grafana setting can be a line here: GF_<SECTION>_<NAME>=value (Grafana's configuration docs list them).
# List only what you set: a line left out uses Grafana's own default (shown in the comment above each).
# Set by the scripts, so a line for one of these is ignored: GF_SERVER_ROOT_URL, GF_SERVER_SERVE_FROM_SUB_PATH,
# GF_SERVER_HTTP_ADDR, GF_SERVER_HTTP_PORT, GF_PATHS_*, GF_SECURITY_ADMIN_PASSWORD,
# GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH, GF_LOG_MODE.
# A change applies at the next .\run.ps1 (laptop). UAT's are the GF_ lines in deploy/deploy_common.yaml.
# -- Who can see and edit --
# Anyone may look without logging in. Grafana's default: false (a login for everything).
GF_AUTH_ANONYMOUS_ENABLED=true
# What a visitor without a login may do: Viewer, Editor or Admin. Grafana's default: Viewer.
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
# Viewers may use Explore (search the logs). Grafana's default: false.
GF_USERS_VIEWERS_CAN_EDIT=true
# Nobody can create their own account. Grafana's default: false.
GF_USERS_ALLOW_SIGN_UP=false
# -- Reporting, analytics and calls to the internet --
# Send usage statistics to Grafana Labs. Grafana's default: true.
GF_ANALYTICS_REPORTING_ENABLED=false
# Check grafana.com for a newer Grafana. Grafana's default: true.
GF_ANALYTICS_CHECK_FOR_UPDATES=false
# Check grafana.com for newer plugins. Grafana's default: true.
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false
# Show the Grafana news feed. Grafana's default: true.
GF_NEWS_NEWS_FEED_ENABLED=false
# true = do not download Grafana's default plugins at start-up. Grafana's default: false.
GF_PLUGINS_PREINSTALL_DISABLED=true
# -- Look and defaults --
# Colour theme for everyone: dark, light or system. Grafana's default: dark.
GF_USERS_DEFAULT_THEME=dark
# Time zone of dates: browser (each viewer's own), utc, or a zone such as Asia/Dubai. Grafana's default: browser.
GF_DATE_FORMATS_DEFAULT_TIMEZONE=browser
# Fastest auto-refresh a dashboard may use. Grafana's default: 5s.
GF_DASHBOARDS_MIN_REFRESH_INTERVAL=5s
